#!/usr/bin/env bash
# Builds and tests FoundryKitNative from a clean checkout.
#
# `swift test` on its own fails on a clean checkout: Foundry-Swift-Binary declares
# path-based binary targets under a Binaries/ directory that is gitignored upstream, so
# resolving the tag leaves the artifacts missing. This prepares them first, then runs the
# suite. Extra arguments are forwarded to `swift test`.
set -euo pipefail

package_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

"$package_dir/scripts/prepare-foundryswift-binary"
cd "$package_dir"
exec swift test "$@"
