#!/usr/bin/env bash
# Builds the Apple auth extension binary and the shared frameworks it loads against.
#
# Output under addons/FoundryKit/bin/, all of it gitignored release artefacts:
#
#   auth/FoundryKitAuth.xcframework                 iOS device + simulator + macOS
#   core/FoundryKitCore.xcframework                 the same three slices
#   core/FoundrySwift_*_PackageProduct.xcframework  likewise
#   core/FoundryKitCore.framework                   macOS — what the editor loads
#   core/FoundrySwift_*_PackageProduct.framework    macOS, beside the framework that
#                                                   links it
#
# The last one is not ours. Xcode wraps the FoundrySwift *package product* in a generated
# framework because that product bundles the FoundrySwift xcframework together with the
# FoundryExtensionC C target, and both FoundryKitCore and FoundryKitAuth link the wrapper
# rather than FoundrySwift.framework directly. Shipping FoundrySwift.framework alone does
# not satisfy that load command, so the wrapper travels with the frameworks that need it.
# Restructuring the upstream product would remove it — tracked as #81.
#
# Every slice of FoundryKitAuth.xcframework also carries the SwiftPM resource bundles of
# the SDKs statically linked into it — see embed_resource_bundles below.
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
package_dir="$repo_root/native/apple/FoundryKitNative"
derived_data="$repo_root/.build/xcodebuild"
auth_bin="$repo_root/addons/FoundryKit/bin/auth"
core_bin="$repo_root/addons/FoundryKit/bin/core"

source "$package_dir/scripts/apple-build-support"

apple_require_tools
apple_generate_project "$package_dir"
apple_prepare_packages "$package_dir" "$derived_data" FoundryKitAuth_macOS

# Each scheme builds its platform's FoundryKitCore too, as a target dependency.
apple_build FoundryKitAuth_iOS "generic/platform=iOS"
apple_build FoundryKitAuth_iOS "generic/platform=iOS Simulator" CODE_SIGNING_ALLOWED=NO
apple_build FoundryKitAuth_macOS "generic/platform=macOS"

products="$derived_data/Build/Products"
platform_directories=(Release-iphoneos Release-iphonesimulator Release)

# The wrapper's name carries a hash of the package product's identity, so resolve it
# rather than writing it down. It is stable for a pinned dependency version, but nothing
# here should break when that version moves.
package_product=$(
	cd "$products/Release/PackageFrameworks" &&
		find . -maxdepth 1 -name 'FoundrySwift_*_PackageProduct.framework' -exec basename {} .framework \;
)
[[ -n "$package_product" ]] ||
	apple_fail "no FoundrySwift package-product framework in $products/Release/PackageFrameworks"

# The .foundryextension files name the wrapper literally — they have no expansion — so a
# pin bump that moves the hash has to fail here. Otherwise it produces a green build whose
# extension names a wrapper that no longer exists, and the failure surfaces only as a
# backend that silently reports itself unavailable at runtime.
"$repo_root/scripts/test-package-product-name" --expect "$package_product"

# Packs one framework's per-platform slices into an xcframework, failing on the first
# slice xcodebuild did not produce rather than emitting a partial artefact.
create_xcframework() {
	local framework=$1
	local output=$2
	local subdirectory=${3:-}
	local arguments=()
	local platform_directory path

	for platform_directory in "${platform_directories[@]}"; do
		path="$products/$platform_directory${subdirectory:+/$subdirectory}/$framework.framework"
		[[ -d "$path" ]] || apple_fail "expected build product is missing: $path"
		arguments+=(-framework "$path")
	done

	rm -rf "$output"
	xcodebuild -create-xcframework "${arguments[@]}" -output "$output"
}

# GoogleSignIn, AppAuth, GTMAppAuth, GTMSessionFetcher, GoogleUtilities and Promises each
# declare SwiftPM resources, so xcodebuild emits a <Package>_<Target>.bundle for each of
# them beside the framework instead of inside it. Two things break if they stay there.
#
# 1. Resource lookup. Every one of those targets is linked *statically* into
#    FoundryKitAuth, so at runtime their classes belong to FoundryKitAuth.framework and
#    that is the bundle they search. GoogleSignIn does it by hand in
#    NSBundle+GID3PAdditions.m:
#
#      [[NSBundle bundleForClass:[GIDSignIn class]] pathForResource:@"GoogleSignIn_GoogleSignIn"
#                                                            ofType:@"bundle"]
#
#    and the SwiftPM-generated accessors the other targets use try the same bundle's
#    resource URL. -pathForResource: searches the bundle's *resource* directory, which is
#    Versions/A/Resources for a versioned macOS framework and the bundle root for a
#    shallow iOS one.
# 2. Privacy manifests. Those bundles are where each SDK's PrivacyInfo.xcprivacy lives.
#    An app embedding the auth extension without them is missing required manifests for
#    SDKs its binary demonstrably contains, which App Store submission rejects.
#
# Copying them into the framework's own resource directory answers both, and is what
# Xcode's copy-resources phase does when a package product is embedded in an app.
embed_resource_bundles() {
	local platform_directory=$1
	local framework="$products/$platform_directory/FoundryKitAuth.framework"
	local resources bundle count=0

	if [[ -d "$framework/Versions/Current/Resources" ]]; then
		resources="$framework/Versions/Current/Resources"
	else
		resources="$framework"
	fi

	# Drop what an earlier run embedded, so a dependency that stops shipping a bundle
	# does not linger in the published framework.
	find "$resources" -maxdepth 1 -name '*.bundle' -exec rm -rf {} +

	for bundle in "$products/$platform_directory"/*.bundle; do
		[[ -d "$bundle" ]] || continue
		cp -R "$bundle" "$resources/"
		count=$((count + 1))
	done

	# The GoogleSignIn bundle is the one with non-manifest resources — strings and the
	# Roboto font the sign-in button draws with — so its absence is a hard failure
	# rather than a missing privacy manifest.
	[[ -d "$resources/GoogleSignIn_GoogleSignIn.bundle" ]] ||
		apple_fail "no GoogleSignIn resource bundle in $products/$platform_directory"

	echo "embedded $count resource bundles in $platform_directory/FoundryKitAuth.framework"
}

mkdir -p "$auth_bin" "$core_bin"

for platform_directory in "${platform_directories[@]}"; do
	embed_resource_bundles "$platform_directory"
done

create_xcframework FoundryKitAuth "$auth_bin/FoundryKitAuth.xcframework"
create_xcframework FoundryKitCore "$core_bin/FoundryKitCore.xcframework"
create_xcframework "$package_product" "$core_bin/$package_product.xcframework" PackageFrameworks

# The editor loads plain macOS frameworks, not xcframeworks, so the macOS slice of every
# shared framework is also published flat in bin/core/. Both have to be here: the flat
# FoundryKitCore.framework links the wrapper by @rpath, and its runpaths reach bin/core/,
# not inside a sibling xcframework.
for framework in FoundryKitCore "$package_product"; do
	rm -rf "${core_bin:?}/$framework.framework"
done
cp -R "$products/Release/FoundryKitCore.framework" "$core_bin/FoundryKitCore.framework"
cp -R "$products/Release/PackageFrameworks/$package_product.framework" "$core_bin/$package_product.framework"

echo "PASS: built FoundryKitAuth.xcframework and the shared core frameworks"
